# MoltsPay Server Configuration
# Copy to ~/.moltspay/.env or ./.env and fill in values

# ===========================================
# Network Configuration
# ===========================================
# true = Base mainnet, false = Base Sepolia testnet
USE_MAINNET=true

# ===========================================
# Facilitator Selection (v0.9.0+)
# ===========================================
# Primary facilitator to use
# Available: cdp
# Coming soon: chaoschain, questflow
FACILITATOR_PRIMARY=cdp

# Fallback facilitators (comma-separated, optional)
# Example: chaoschain,questflow
# FACILITATOR_FALLBACK=

# Selection strategy when multiple facilitators available
# Options: failover | cheapest | fastest | random | roundrobin
FACILITATOR_STRATEGY=failover

# ===========================================
# Skill Execution (v0.9.4+)
# ===========================================
# Timeout for skill execution in seconds (default: 1200 = 20 minutes)
# Prevents hung skills from blocking requests forever
SKILL_TIMEOUT_SECONDS=1200

# ===========================================
# Proxy Endpoint (v0.9.2+)
# ===========================================
# IP whitelist for /proxy endpoint (comma-separated)
# Used by external services like moltspay-creators to delegate payment handling
# If not set, /proxy endpoint is disabled (secure by default)
# Example: 127.0.0.1,::1,203.0.113.50
PROXY_ALLOWED_IPS=127.0.0.1,::1

# ===========================================
# CDP Facilitator (Coinbase)
# ===========================================
# Required for mainnet. Get credentials from:
# https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ===========================================
# ChaosChain Facilitator (Coming Soon)
# ===========================================
# https://github.com/ChaosChain/chaoschain-x402
# CHAOSCHAIN_ENDPOINT=https://x402.chaoschain.io
# CHAOSCHAIN_API_KEY=

# ===========================================
# Questflow Facilitator (Coming Soon)
# ===========================================
# https://facilitator.questflow.ai/
# QUESTFLOW_ENDPOINT=https://facilitator.questflow.ai
# QUESTFLOW_API_KEY=

# ===========================================
# Solana Relay Fee Payer
# ===========================================
# Private key for paying Solana transaction fees (base58 encoded)
# Required for server-side settlement on Solana chains
# SOLANA_FEE_PAYER_KEY=

# ===========================================
# BNB Chain Relay Fee Payer
# ===========================================
# Private key for paying BNB Chain transaction fees
# Required for server-side settlement on BNB chains (bsc, opbnb)
# BNB_SERVER_PRIVATE_KEY=

# ===========================================
# Public Base URL (2.4.0+)
# ===========================================
# Absolute base URL this server is reached at, INCLUDING any deployment path
# prefix (e.g. behind a reverse proxy at /t/my-service). When set, service
# discovery emits absolute endpoints / 402 resource URLs so a discovering agent
# lands on the right backend instead of the domain root. Leave unset for
# local / no-prefix deployments (falls back to relative paths).
# PUBLIC_BASE_URL=https://your.host/your/prefix

# ===========================================
# Fiat & Balance Rails (Alipay / WeChat / custodial balance)
# ===========================================
# These rails are NOT configured here — their merchant credentials and pricing
# live in your moltspay.services.json manifest (provider.alipay / provider.wechat
# / provider.balance + per-service blocks), referenced by ID and key-file path.
# See the rail docs:
#   Alipay:  https://github.com/Yaqing2023/moltspay/blob/v2.4.0/docs/ALIPAY-RAIL.md
#   WeChat:  https://github.com/Yaqing2023/moltspay/blob/v2.4.0/docs/WECHAT-RAIL-DESIGN.md
#   Balance: https://github.com/Yaqing2023/moltspay/blob/v2.4.0/docs/WECHAT-BALANCE-PASSWORDLESS-DESIGN.md
# Balance spend authentication is the manifest knob provider.balance.auth_mode
# (off | shadow | enforce); see "Balance Authentication (2.4.0)" in the README.
